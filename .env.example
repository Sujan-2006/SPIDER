# SPIDER Platform Environment Variables

# Supabase Database & Auth (Required for Live DB Mode)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Netlify Deploy API Token (Optional - Users can also enter in UI dialog)
VITE_NETLIFY_ACCESS_TOKEN=your-netlify-personal-access-token

# App Configuration
VITE_APP_URL=http://localhost:5173
